# Admin panel — separate deployment. This is the ONLY app that gets the service-role key.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only: bypasses RLS. Set in the admin Vercel project ONLY.
SUPABASE_SERVICE_ROLE_KEY=

# Razorpay (refunds, migration 041) — same account/keys as apps/customer, but both
# server-only here (admin never opens Checkout in the browser, so no NEXT_PUBLIC).
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# ── Admin hardening (W3.5) ────────────────────────────────────────────────
# TOTP two-factor enforcement. Order matters — TOTP must be ON in the dashboard
# BEFORE this flag, or enroll() fails and login dead-ends:
#   1. Supabase dashboard → Authentication → MFA → enable TOTP (per project)
#   2. set this to "true" for that environment
#   3. each admin signs in → guided through QR enrollment automatically, then
#      every login needs the 6-digit code and every service-role action needs aal2
# Enrollment is sticky: an admin who HAS enrolled must always pass the code
# check, even if this flag is later turned off.
NEXT_PUBLIC_ADMIN_REQUIRE_MFA=

# Comma-separated emails allowed into the panel (case-insensitive).
# Unset/empty = any admin-role account. Server-only — never NEXT_PUBLIC.
# ⚠️ Your OWN admin email must be on this list or you lock yourself out — a
# denied session is signed out at the login page. Recovery: unset this and
# restart the app. Set it per environment (dev + prod are separate projects).
# e.g. ADMIN_EMAIL_ALLOWLIST=you@example.com,cofounder@example.com
ADMIN_EMAIL_ALLOWLIST=
