{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "fitxo-store",
  "main": ".open-next/worker.js",
  // Must be 2024-09-23 or later for the adapter. nodejs_compat is what lets
  // node:crypto work, which the Razorpay signature checks depend on.
  "compatibility_date": "2024-12-30",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "fitxo-store"
    }
  ],
  "observability": {
    "enabled": true
  }
}
