# Customer (public site) — anon/public keys only. NEVER put the service-role key here.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Razorpay — Key ID is public (sent to browser for Checkout); SECRET is server-only.
NEXT_PUBLIC_RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Webhook secret — set in Razorpay Dashboard → Settings → Webhooks; the SAME value
# must also be stored in Supabase Vault as `razorpay_webhook_secret` (migration 039).
RAZORPAY_WEBHOOK_SECRET=

# ── Sign-in methods (W4.4) ────────────────────────────────────────────────
# Only offer a method the Supabase project actually has enabled — otherwise the
# button is dead and the customer gets a raw provider error in a toast.
# Unset/anything-but-"true" = hidden. Check what a project has on with:
#   curl -s "$NEXT_PUBLIC_SUPABASE_URL/auth/v1/settings" -H "apikey: $ANON_KEY"
#
# Phone OTP login. Needs an SMS provider + DLT registration in India (W1.2/B7).
# While off, the login field is "Email" only and the password box always shows.
NEXT_PUBLIC_PHONE_AUTH_ENABLED=
# "Continue with Google". Needs a Google Cloud OAuth client configured on the
# Supabase project (Authentication → Providers → Google) with the callback
# https://<ref>.supabase.co/auth/v1/callback, plus /auth/callback allowlisted.
NEXT_PUBLIC_GOOGLE_AUTH_ENABLED=
