# Customer (public site) — anon/public keys only. NEVER put the service-role key here.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Razorpay — Key ID is public (sent to browser for Checkout); SECRET is server-only.
NEXT_PUBLIC_RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Webhook secret — set in Razorpay Dashboard → Settings → Webhooks; the SAME value
# must also be stored in Supabase Vault as `razorpay_webhook_secret` (migration 039).
RAZORPAY_WEBHOOK_SECRET=
