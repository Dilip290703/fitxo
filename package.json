{
  "name": "fitzo-monorepo",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "dev": "pnpm --parallel --filter @fitzo/customer --filter @fitzo/admin run dev",
    "dev:all": "pnpm --parallel -r run dev",
    "dev:customer": "pnpm --filter @fitzo/customer dev",
    "dev:admin": "pnpm --filter @fitzo/admin dev",
    "dev:agent": "pnpm --filter @fitzo/agent dev",
    "dev:store": "pnpm --filter @fitzo/store dev",
    "build": "pnpm -r build",
    "build:customer": "pnpm --filter @fitzo/customer build",
    "build:admin": "pnpm --filter @fitzo/admin build",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm -r lint",
    "rls-probe": "node scripts/supabase/rls-probe.mjs"
  }
}
