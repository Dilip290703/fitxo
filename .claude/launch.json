{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "agent",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["dev:agent"],
      "port": 3002
    },
    {
      "name": "customer",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["dev:customer"],
      "port": 3000,
      "autoPort": true
    },
    {
      "name": "store",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["dev:store"],
      "port": 3003
    },
    {
      "name": "store-verify",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["--filter", "@fitzo/store", "exec", "next", "dev", "--port", "3013"],
      "port": 3013
    }
  ]
}
